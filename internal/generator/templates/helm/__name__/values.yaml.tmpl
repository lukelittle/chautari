# Default values for the [[ .Name ]] Chautari chart ([[ or .Estate.Org .Estate.Name ]]).
# Generated by `chautari generate` from estate.cdl. Edits here are preserved:
# the generator skips files a human has changed, and tells you.
#
# Install (from the generated output root):
#   helm install [[ .Name ]] ./helm/[[ .Name ]] \
#     --set-file estate=estate.cdl \
#     --set database.url='postgres://chautari:PASSWORD@db.example.internal:5432/chautari?sslmode=require'

# -- The estate CDL source. Required. Set it with --set-file estate=estate.cdl so
# the cluster runs exactly the file that was reviewed.
estate: ""

# -- Data plane adapter: agentgateway or litellm. Must match the estate.
dataplane: [[ .Dataplane ]]

nameOverride: ""
fullnameOverride: ""

# -- Control plane replicas. Every replica resyncs registry state from Postgres,
# so more than one is safe.
replicaCount: 2

image:
[[- $default := printf "ghcr.io/lukelittle/chautari:%s" .Version ]]
[[- if eq .Image $default ]]
  repository: ghcr.io/lukelittle/chautari
  # -- Defaults to the chart appVersion.
  tag: ""
[[- else ]]
  # -- A full reference (with tag or digest) is used as-is.
  repository: [[ .Image | quote ]]
  tag: ""
[[- end ]]
  pullPolicy: IfNotPresent

imagePullSecrets: []

# The data plane runs as a sidecar in the same pod and is never exposed
# outside it: the checkpoint on :8080 is the only way in.
gateway:
  image:
    # -- A full reference (with tag or digest) is used as-is.
    repository: [[ .GatewayImage | quote ]]
    tag: ""
    pullPolicy: IfNotPresent
  # -- Override the data plane arguments. Empty means the adapter default.
  args: []
  # -- Route A2A traffic through the gateway's A2A listener (:3100).
  a2a: [[ .HasA2A ]]
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      memory: [[ if eq .Dataplane "litellm" ]]1Gi[[ else ]]512Mi[[ end ]]
  securityContext:
    allowPrivilegeEscalation: false
    # [[ if eq .Dataplane "litellm" ]]LiteLLM writes to its install directory at start-up.[[ else ]]agentgateway needs no writable root filesystem.[[ end ]]
    readOnlyRootFilesystem: [[ ne .Dataplane "litellm" ]]
    capabilities:
      drop: ["ALL"]

# Credentials. Either name an existing Secret, or let the chart create one.
#
# An existing Secret must hold these keys:
#   CHAUTARI_DATABASE_URL, CHAUTARI_GATEWAY_KEY, CHAUTARI_DIGEST_KEY, and either
#   CHAUTARI_ADMIN_TOKENS (per-person, recommended) or CHAUTARI_ADMIN_TOKEN
# and, optionally, one key per provider credential listed under providerKeys.
existingSecret: ""

secrets:
  # -- Per-person admin tokens, "name=token,name=token". Recommended: the token
  # says who is acting, so separation of duties is enforced. Set with
  # --set-file or an existing Secret rather than in a values file.
  adminTokens: ""
  # -- Shared admin token, used only when adminTokens is empty. Generated (and
  # kept across upgrades) when empty. People name themselves at sign-in, so
  # separation of duties is advisory.
  adminToken: ""
  # -- Key for prompt HMACs in the audit log. Generated when empty.
  digestKey: ""
  # -- Internal key the checkpoint presents to the data plane. Generated when empty.
  gatewayKey: ""

database:
  # -- Postgres URL. Required unless existingSecret is set.
  # e.g. postgres://chautari:PASSWORD@my-db.abc123.us-east-1.rds.amazonaws.com:5432/chautari?sslmode=require
  url: ""

# -- Provider credentials, read only by the data plane container. Keys are the
# environment variable names the estate's providers declare.
[[- if .ProviderEnvs ]]
providerKeys:
[[- range .ProviderEnvs ]]
  [[ . ]]: ""
[[- end ]]
[[- else ]]
providerKeys: {}
[[- end ]]

# -- Extra Rego files (file name -> source) mounted at /etc/chautari/policy.
# Each may contribute `deny contains msg if { ... }` rules.
policies: {}

aws:
  # -- AWS region for Bedrock calls[[ if not .UsesBedrock ]] (unused: no provider or guardrail needs Bedrock)[[ end ]].
  region: [[ if .UsesBedrock ]][[ with .Estate.Region ]][[ . ]][[ else ]]us-east-1[[ end ]][[ else ]]""[[ end ]]

otel:
  # -- OTLP/HTTP endpoint, e.g. http://otel-collector.observability:4318. Empty disables export.
  endpoint: ""
  serviceName: chautari

serviceAccount:
  create: true
  # -- Annotations for the ServiceAccount.
[[- if .UsesBedrock ]]
  # This estate calls AWS Bedrock: on EKS, bind an IAM role (IRSA) allowing
  # bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream and
  # bedrock:ApplyGuardrail, e.g.
  #   eks.amazonaws.com/role-arn: arn:aws:iam::123456789012:role/[[ .Name ]]-bedrock
  # (or use an EKS Pod Identity association instead).
[[- end ]]
  annotations: {}
  name: ""
  automount: false

podAnnotations: {}
podLabels: {}

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65532
  runAsGroup: 65532
  fsGroup: 65532
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: ["ALL"]

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    memory: 512Mi

service:
  type: ClusterIP
  port: 8080

ingress:
  enabled: false
  className: ""
  annotations: {}
  hosts:
    - host: [[ .Name ]].example.com
      paths:
        - path: /
          pathType: Prefix
  tls: []
  #  - secretName: [[ .Name ]]-tls
  #    hosts:
  #      - [[ .Name ]].example.com

podDisruptionBudget:
  enabled: true
  minAvailable: 1

networkPolicy:
  enabled: true
  # -- Peers allowed to reach :8080. Empty allows any source (the port is still
  # the only one open). Example: restrict to the ingress controller namespace.
  from: []
  #  - namespaceSelector:
  #      matchLabels:
  #        kubernetes.io/metadata.name: ingress-nginx

nodeSelector: {}
tolerations: []
affinity: {}
topologySpreadConstraints: []

extraEnv: []
