# Secrets for the [[ .Estate.Org ]] stack. Copy to .env and fill in.
# `docker compose up` refuses to start without the required ones.

# Administrators, one personal token each (name=token,name=token; tokens of
# 16+ characters). The token says who is acting, so separation of duties is
# enforced. Generate tokens with: openssl rand -hex 24
CHAUTARI_ADMIN_TOKENS=alice@example.com=change-me-0000000000000000,bob@example.com=change-me-1111111111111111[[ if .Demo ]],demo-traffic=change-me-2222222222222222[[ end ]]
# Or, for a quick trial only, one shared token (people name themselves):
# CHAUTARI_ADMIN_TOKEN=change-me
[[- if .Demo ]]
# The demo traffic generator mints keys with an admin token. Give it its own
# personal token above (e.g. demo-traffic=...) and repeat it here.
CHAUTARI_TRAFFIC_TOKEN=change-me-2222222222222222
[[- end ]]
# Key for prompt HMACs in the audit log. Required.
CHAUTARI_DIGEST_KEY=change-me-digest
# Shared secret between the checkpoint and the data plane.
CHAUTARI_GATEWAY_KEY=change-me-too
# Postgres password.
POSTGRES_PASSWORD=change-me-three
[[- range .ProviderEnvs ]]

# Provider credential, read only by the data plane.
[[ . ]]=
[[- end ]]
[[- if .UsesBedrock ]]

# AWS credentials for Bedrock (or use an instance/task role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=[[ .Estate.Region ]]
[[- end ]]
